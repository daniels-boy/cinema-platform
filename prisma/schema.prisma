// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Required Models ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Para login com credenciais (hash bcrypt)
  role          String    @default("USER")   // "USER" | "ADMIN"
  banned        Boolean   @default(false)
  suspendedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  reviews            Review[]
  watched            Watched[]
  watchlist          Watchlist[]
  featuredFavorites  FeaturedFavorite[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Domínio da Aplicação ─────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  tmdbId    Int      // ID do filme na API do TMDB
  rating    Int      // 1 a 5 estrelas
  content   String   @db.Text
  tags      String[] @default([]) // Tags de Reação Rápida ("Hot Takes")
  isSpoiler Boolean  @default(false) // Marcado pelo admin como spoiler
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId]) // Um usuário só pode ter uma review por filme
  @@map("reviews")
}

model Watched {
  id        String   @id @default(cuid())
  tmdbId    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@map("watched")
}

model Watchlist {
  id        String   @id @default(cuid())
  tmdbId    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@map("watchlist")
}

model FeaturedFavorite {
  id        String   @id @default(cuid())
  tmdbId    Int
  position  Int      // 1 a 5
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position]) // Apenas um filme por posição para cada usuário
  @@unique([userId, tmdbId])   // Um filme não pode ser repetido nos favoritos destacados do mesmo usuário
  @@map("featured_favorites")
}

// ─── Admin: Curadoria da Homepage ─────────────────────────────────────────────

model FeaturedBanner {
  id        String   @id @default(cuid())
  tmdbId    Int
  title     String   // Título de exibição (pode ser personalizado)
  subtitle  String?  // Subtítulo/descrição opcional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("featured_banners")
}

model CuratedCollection {
  id          String   @id @default(cuid())
  title       String               // Ex: "Especial Halloween"
  description String?              // Descrição da coleção
  emoji       String   @default("🎬")
  tmdbIds     Int[]    @default([]) // IDs dos filmes selecionados
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("curated_collections")
}
